<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher picker preview. Same composition and same numbers as widget_next.xml, with
     sample content standing in for the renderer's: the label and the answer come from the same
     strings the widget uses, so the picker speaks the system language instead of English, and
     the answer shown is the longest one this widget can produce, which is the case that decides
     the layout in Portuguese and Spanish. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <!-- The catalog surface. A free style keeps the root background and leaves this gone; a
         palette shows it and tints it, covering the root with the same rounded shape. -->
    <ImageView
        android:id="@+id/widget_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_tint"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/px_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/px_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_next_label"
            android:textColor="@color/widget_ink2"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- The answer. Tabular figures because it is a time readout, and tightened line
             spacing because the sentence is two lines in Portuguese and Spanish and reads as
             one block only when the lines sit close. -->
        <TextView
            android:id="@+id/px_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:text="@string/widget_window_now"
            android:textColor="@color/widget_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- The separation between the answer and its evidence, and the only elastic thing in
             the composition: it takes whatever height the launcher gives beyond the content, so
             the bar and the range stay on the card's baseline instead of leaving a dead gap
             below them, and it collapses to nothing before any text is asked to shrink. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:orientation="vertical" />

        <!-- 12dp rather than 10dp so the now mark, a filled dot over a ring, survives the
             scale down: the ring is 3 of the bitmap's 24 rows. The picker gets the empty
             track, since a still preview has no window and no now mark to place. -->
        <ImageView
            android:id="@+id/px_image"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/widget_window_bar_a11y"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bar_placeholder" />

        <!-- Two lines, never three. The renderer writes the range on the first and the cities
             on the second; when the range itself wraps, the range wins and the city count is
             dropped, because the renderer also puts both into this view's description. -->
        <TextView
            android:id="@+id/px_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="2"
            android:text="14:00 - 16:00\nLisbon · Cities: 3"
            android:textColor="@color/widget_ink2"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
