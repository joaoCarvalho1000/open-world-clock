            android:text="10h ahead"
                android:textColor="@color/wc_night_ink2"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- The readout is one lockup, so AM/PM sits on the digits' baseline instead of
             floating at the row's centre. -->
        <LinearLayout
            android:layout_width="wrap_content"
