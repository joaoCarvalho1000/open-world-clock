<?xml version="1.0" encoding="utf-8"?>
<!-- Next window, 4x2. Answer first: the sentence leads, the bar and the range support it.
     Height budget at the declared 190dp minimum, measured at 1.5x font scale with the worst
     case content (a two line answer, as Portuguese and Spanish produce, and a two line detail):
     24 padding + 21.2 title + 2 + 68.2 answer + 0 gap + 8 + 12 bar + 6 + 38.8 detail = 180.2dp.
     The spare 9.8dp is the margin for launcher chrome and font metric differences. Every number
     above is a line count times its size, so nothing here may gain a line without paying for it:
     a third detail line costs 17.5dp at 1.5x and breaks the declared minimum, which is exactly
     how this layout overflowed before. The detail is therefore capped at two lines. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <!-- The catalog surface. A free style keeps the root background and leaves this gone; a
         palette shows it and tints it, covering the root with the same rounded shape. -->
    <ImageView
        android:id="@+id/widget_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_tint"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/px_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/px_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_ink2"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- The answer. Tabular figures because it is a time readout, and tightened line
             spacing because the sentence is two lines in Portuguese and Spanish and reads as
             one block only when the lines sit close. -->
        <TextView
            android:id="@+id/px_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:textColor="@color/widget_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- The separation between the answer and its evidence, and the only elastic thing in
             the composition: it takes whatever height the launcher gives beyond the content, so
             the bar and the range stay on the card's baseline instead of leaving a dead gap
             below them, and it collapses to nothing before any text is asked to shrink. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:orientation="vertical" />

        <!-- 12dp rather than 10dp so the now mark, a filled dot over a ring, survives the
             scale down: the ring is 3 of the bitmap's 24 rows. -->
        <ImageView
            android:id="@+id/px_image"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/widget_window_bar_a11y"
            android:scaleType="fitXY" />

        <!-- Two lines, never three. The renderer writes the range on the first and the cities
             on the second; when the range itself wraps, the range wins and the city count is
             dropped, because the renderer also puts both into this view's description. -->
        <TextView
            android:id="@+id/px_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="2"
            android:textColor="@color/widget_ink2"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
