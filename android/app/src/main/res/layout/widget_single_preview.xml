<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher picker's preview. It mirrors widget_single.xml exactly, with sample text in
     place of the renderer's bindings, so what is picked is what is placed. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="@dimen/widget_padding">

    <LinearLayout
        android:id="@+id/single_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/single_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:text="Lisbon"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/single_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/widget_daytime"
                android:src="@drawable/ic_widget_sun" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_weight="1"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/single_time"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="64sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-light"
                android:fontFeatureSettings="tnum"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="44sp" />

            <TextClock
                android:id="@+id/single_ampm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:format12Hour="a"
                android:format24Hour="a"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_ink2"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextClock
            android:id="@+id/single_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:format12Hour="EEE d MMM"
            android:format24Hour="EEE d MMM"
            android:maxLines="1"
            android:textColor="@color/widget_ink2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/single_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:letterSpacing="0.01"
            android:maxLines="1"
            android:text="Same time · Daylight"
            android:textColor="@color/widget_ink2"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
