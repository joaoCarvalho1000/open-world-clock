<?xml version="1.0" encoding="utf-8"?>
<!-- Clock change, 4x2. Answer-first: one sentence leads, one labelled readout closes.
     Ten months of the year there is no transition coming, so the empty state is the primary
     composition, not a fallback: the sentence still fills the headline slot and the readout line
     still carries standing evidence (each city with its current offset). The vertical air between
     them is the separation; no rule is drawn here, because a hairline in this app means a day seam
     and nothing else.
     px_summary is the only view that takes the leftover height, so growing the widget grows the
     air under the answer and shrinking it (or 1.5x font scale at the 150dp minimum) clips the
     answer last, never the eyebrow or the readout. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <!-- The catalog surface. A free style keeps the root background and leaves this gone; a
         palette shows it and tints it, covering the root with the same rounded shape. -->
    <ImageView
        android:id="@+id/widget_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_tint"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/px_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Eyebrow. Names the question; never carries an answer. -->
        <TextView
            android:id="@+id/px_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:textColor="@color/widget_accent"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- The answer. 18sp is the ceiling that still holds the Portuguese and Spanish wording in
             two lines at 1.5x font scale on a 360dp screen; 20sp pushes them to three. -->
        <TextView
            android:id="@+id/px_summary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="top"
            android:lineSpacingMultiplier="1.05"
            android:maxLines="2"
            android:textColor="@color/widget_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Evidence, pinned to the bottom edge. One line only: when it cannot fit it truncates a
             trailing city, which costs nothing, rather than stealing a line from the answer.
             Tabular figures so offsets and times line up. -->
        <TextView
            android:id="@+id/px_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="12sp" />

        <!-- Reserved third line. The renderer keeps it gone in this composition; it exists so the
             id stays bound and so a future note can appear without a layout change. -->
        <TextView
            android:id="@+id/px_meta0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/widget_ink2"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
