<?xml version="1.0" encoding="utf-8"?>
<!--
    The picker preview for Duo. It is the same composition as widget_duo.xml, band for band, so the
    launcher shows the widget rather than a drawing of it.

    Two things a static preview cannot have: the sky, which is a generated bitmap, and the per city
    day or night surface, which depends on where the sun actually is. Rather than claim either, the
    tiles stay plain and the preview makes the point it can make honestly: two cities, two real
    times, and how far apart they are. The clocks carry their own time zone, so the pair genuinely
    differs in the picker instead of showing the launcher's local time twice; the android:text
    values are the fallback for launchers that rasterise this layout without attaching it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/widget_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_tint"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/duo_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/tile0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_row_plain"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/tile_icon0"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@string/widget_daytime"
                    android:src="@drawable/ic_widget_sun" />

                <TextView
                    android:id="@+id/tile_name0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Lisbon"
                    android:textColor="@color/widget_ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextClock
                android:id="@+id/tile_time0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                    android:minHeight="22dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-light"
                android:fontFeatureSettings="tnum"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:letterSpacing="-0.01"
                android:maxLines="1"
                android:text="14:32"
                android:textColor="@color/widget_ink"
                android:textSize="40sp"
                android:timeZone="Europe/Lisbon" />

            <TextView
                android:id="@+id/tile_date0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Sun 11 Oct"
                android:textColor="@color/widget_ink2"
                android:textSize="11sp" />

            <!-- The first city is the one the other is measured against, so it has no difference to
                 state. Empty here, and View.INVISIBLE in the renderer, which keeps the footer band
                 the same height in both tiles and the two clocks level. -->
            <TextView
                android:id="@+id/tile_meta0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_ink2"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_row_plain"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/tile_icon1"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@string/widget_daytime"
                    android:src="@drawable/ic_widget_sun" />

                <TextView
                    android:id="@+id/tile_name1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Tokyo"
                    android:textColor="@color/widget_ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextClock
                android:id="@+id/tile_time1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                    android:minHeight="22dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-light"
                android:fontFeatureSettings="tnum"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:letterSpacing="-0.01"
                android:maxLines="1"
                android:text="22:32"
                android:textColor="@color/widget_ink"
                android:textSize="40sp"
                android:timeZone="Asia/Tokyo" />

            <TextView
                android:id="@+id/tile_date1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Mon 12 Oct"
                android:textColor="@color/widget_ink2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tile_meta1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="+8h"
                android:textColor="@color/widget_ink2"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
