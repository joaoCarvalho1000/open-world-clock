<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <!-- The catalog surface. A free style keeps the root background and leaves this gone; a
         palette shows it and tints it, covering the root with the same rounded shape. -->
    <ImageView
        android:id="@+id/widget_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_tint"
        android:visibility="gone" />

    <!-- Three bands, and only two of them are text. The arc answers the question this widget
         exists for, so it gets the full width and every dp the two text bands do not need.
         Vertical padding is 10dp rather than 12dp for the same reason. -->
    <LinearLayout
        android:id="@+id/px_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <!-- Clock-first. The readout leads and the city sits on its baseline at a bit over a
             third of its size, so one line carries both. Stacking the name above the clock
             would read the same and cost the arc about 16dp, a fifth of the graphic. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/px_clock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="28sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-light"
                android:fontFeatureSettings="tnum"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:letterSpacing="-0.01"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="28sp" />
            <!-- Weighted, not wrap_content: a long name can never squeeze the clock, and the
                 clock keeps the larger share because "12:45 PM" at 1.5x is the widest thing
                 this row has to hold. -->
            <TextView
                android:id="@+id/px_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_ink2"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- The graphic. Full width and weight 1, so resizing the widget taller spends the
             new room on the arc rather than on larger type. -->
        <ImageView
            android:id="@+id/px_image"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/widget_solar_arc_a11y"
            android:scaleType="fitXY" />

        <!-- The two named numbers, start and end aligned under the ends of the curve they
             mark, and held close to it so they read as its labels and not as a footer.
             Tabular figures, full ink: these are readouts, not captions. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/px_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="2"
                android:textColor="@color/widget_ink"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/px_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- A fixed graphic height is what makes its aspect knowable, so the leftover height
             lives here instead. On API 31 and up the renderer sets the real height and this
             collapses. -->
        <LinearLayout
            android:id="@+id/graphic_slack"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
