<?xml version="1.0" encoding="utf-8"?>
<!-- The one widget surface every catalog palette paints, tinted by the renderer. White so a
     colour filter replaces it exactly, keeping the shape's own antialiased corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/white" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
