<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="io.joao.worldclock.widget.WidgetConfigureActivity"
    android:description="@string/widget_world_description"
    android:initialLayout="@layout/widget_world"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="80dp"
    android:maxResizeWidth="600dp"
    android:maxResizeHeight="600dp"
    android:previewImage="@drawable/widget_preview_world"
    android:previewLayout="@layout/widget_world_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
