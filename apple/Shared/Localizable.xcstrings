    "settings.widgets": {
      "comment": "settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold an empty spot on your Home Screen, tap Edit, then Add Widget (on iOS 17, tap +), and pick World Clock. On the Lock Screen, touch and hold, then tap Customize."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionado un espacio vacío de la pantalla de inicio, toca Editar, luego Agregar widget (en iOS 17, toca +) y elige World Clock. En la pantalla bloqueada, mantén presionado y luego toca Personalizar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha pressionado um espaço vazio da Tela de Início, toque em Editar e depois em Adicionar Widget (no iOS 17, toque em +). Então escolha World Clock. Na Tela Bloqueada, mantenha pressionado e toque em Personalizar."
          }
        }
      }
    },
