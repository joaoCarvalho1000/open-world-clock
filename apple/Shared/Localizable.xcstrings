    "settings.privacy": {
      "comment": "settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works fully offline. No accounts, no tracking, no network access. Your cities stay on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona totalmente sin conexión. Sin cuentas, sin rastreo, sin acceso a la red. Tus ciudades se quedan en este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona totalmente offline. Sem cadastro, sem rastreamento, sem acesso à rede. Suas cidades ficam neste aparelho."
          }
        }
      }
    },
