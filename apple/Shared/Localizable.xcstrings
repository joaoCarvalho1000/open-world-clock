    "tip.chip1": {
      "comment": "tip",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a time like 3pm or 3pm Tokyo to see it in every city"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una hora como 3pm o 3pm Tokio para verla en todas las ciudades"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um horário como 15h ou 15h Tóquio para ver em todas as cidades"
          }
        }
      }
    },
    "tip.chip2": {
      "comment": "tip",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll over a clock, or drag its day line, to move through the day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la rueda sobre un reloj o arrastra su línea del día para cambiar la hora"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Role sobre um relógio, ou arraste a linha do dia, para mudar o horário"
          }
        }
      }
    },
    "tip.chip3": {
      "comment": "tip",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-click a city to convert from its time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz doble clic en una ciudad para convertir desde su hora"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique duas vezes numa cidade para converter a partir dela"
          }
        }
      }
    },
    "tip.chip4": {
      "comment": "tip",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click a city to rename it or set its working hours"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic derecho en una ciudad para cambiar su nombre o su horario laboral"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito numa cidade para renomear ou definir o expediente"
          }
        }
      }
    },
    "tip.chip5": {
      "comment": "tip",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag cards to reorder, and drag empty space to move the window"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra las tarjetas para ordenarlas y el espacio vacío para mover la ventana"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste os cartões para reordenar e o espaço vazio para mover a janela"
          }
        }
      }
    },
