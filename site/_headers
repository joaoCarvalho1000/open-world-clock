# Scripts and styles keep their names across releases, so browsers must recheck them on every visit (a cheap 304 via
# ETag). Without this the zone's 4 hour browser cache kept an old config.js that pointed downloads at GitHub.
/assets/*.js
  Cache-Control: public, max-age=0, must-revalidate
/assets/*.css
  Cache-Control: public, max-age=0, must-revalidate
/app/*
  Cache-Control: public, max-age=0, must-revalidate

# Fonts never change under the same name
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images and icons: a week, then refreshed in the background
/assets/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/og.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/og-pt.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
